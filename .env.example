# =============================================================================
# digitplustechnology.com — environment contract
# Copy to `.env.local` and fill in to enable real integrations.
#
# EVERYTHING IS OPTIONAL. With NO values set, all integrations run in STUB mode:
# they validate, log to the server console, and return success. The site builds
# and runs fully without any keys. Set a group's vars to switch that provider on
# WITHOUT any code changes (see src/lib/integrations/*).
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical absolute URL (no trailing slash). Used for metadata/canonicals.
NEXT_PUBLIC_SITE_URL=https://digitplustechnology.com

# -----------------------------------------------------------------------------
# Internal notification email (src/lib/integrations/email.ts)
# Set EITHER Resend (recommended) OR the full SMTP_* group to send the
# "new lead" notification to hello@digitplustechnology.com.
# -----------------------------------------------------------------------------
# Resend (https://resend.com) — WIRED via REST (no extra dependency). Set the
# key and verify your sending domain; notifications then send automatically.
RESEND_API_KEY=
# From address used for outbound notifications (Resend or SMTP).
EMAIL_FROM="Digitplus Leads <leads@digitplustechnology.com>"

# SMTP fallback (add `nodemailer` to package.json to use). ALL four required.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Email marketing list (src/lib/integrations/marketing.ts)
# WIRED for Brevo (contacts upsert) via REST. BOTH required to activate.
# MARKETING_LIST_ID must be the numeric Brevo list id. (Mailchimp: see code note.)
# -----------------------------------------------------------------------------
MARKETING_API_KEY=
MARKETING_LIST_ID=

# -----------------------------------------------------------------------------
# CRM (src/lib/integrations/crm.ts)
# WIRED for BOTH: a generic webhook (simplest — Zapier/Make/HubSpot workflow) AND
# HubSpot Contacts API (CRM_API_KEY = private-app token). Webhook wins if both set.
# -----------------------------------------------------------------------------
CRM_WEBHOOK_URL=
CRM_API_KEY=

# -----------------------------------------------------------------------------
# Analytics — Plausible, WIRED (src/components/analytics/Analytics.tsx + analytics.ts)
# Set NEXT_PUBLIC_ANALYTICS to your site domain to load Plausible (cookieless,
# privacy-first) and enable track() events. Leave blank = no tracker loads.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS=
# Optional: self-hosted / proxied Plausible script URL (defaults to plausible.io).
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.tagged-events.js

# -----------------------------------------------------------------------------
# Lead persistence — Supabase, WIRED via REST (src/lib/integrations/store.ts)
# BOTH required to durably store leads; absent = in-memory only (lost on
# redeploy). Run supabase/migrations/0001_leads.sql once to create the table.
# Use the SERVICE ROLE key (server-only secret) — never the anon/publishable key.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Rate limiting — Upstash Redis, WIRED via REST (src/lib/integrations/rate-limit.ts)
# BOTH required for a shared cross-instance window on serverless; absent = best-
# effort in-memory per-instance limiting. Create a free Upstash Redis DB and copy
# its REST URL + token. Fails open (allows) if Upstash is unreachable.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
